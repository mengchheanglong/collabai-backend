# CollabAI Backend - Environment variable template
# Copy this file to .env.local and fill in real values.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/collabai"

# JWT
JWT_SECRET="your-secret-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-key"

# Application
NODE_ENV="development"
# Frontend targets http://localhost:4000/api/v1
PORT=4000
# Angular dev server origin allowed by CORS (credentials enabled for the refresh cookie).
FRONTEND_ORIGIN="http://localhost:4200"

# Redis (token blacklist, account lockout, rate limiting).
# Optional in dev — Redis-backed features fail open if this is unreachable.
REDIS_URL="redis://localhost:6379"

# AI (server-side only). If OPENAI_API_KEY is unset, the AI module falls back to a
# deterministic stub provider so the app still runs (useful in dev/tests).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Email — pluggable backends: log | smtp | resend | mailjet
# If EMAIL_BACKEND is unset it auto-detects: RESEND_API_KEY > MAILJET_* > SMTP_* > log.
# NOTE: Render's free tier blocks outbound SMTP ports (25/465/587) since Sept 2025 —
# use resend or mailjet there (both go over HTTPS and are never blocked).
# EMAIL_BACKEND="log"

# SMTP backend (local dev only — does NOT work on Render free tier)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="you@example.com"
EMAIL_PASS="your-gmail-app-password"
SMTP_FROM='CollabAI <noreply@example.com>'

# Resend backend (https://resend.com — free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=""

# Mailjet backend (https://www.mailjet.com — free tier: 200 emails/day)
# The sender below MUST match an address marked Active under Mailjet > Domains and senders.
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""

# Sender address used by every backend. Highest precedence; falls back to
# SMTP_FROM -> EMAIL_USER -> CollabAI <no-reply@localhost>.
DEFAULT_FROM_EMAIL=""

# AI provider: "openai" (default) or "deepseek"
AI_PROVIDER="deepseek"

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
